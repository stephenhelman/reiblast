generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  passwordHash String?
  plan         String  @default("core")
  // Status values:
  // pending_onboarding — paid, form not submitted
  // onboarding_complete — form submitted, awaiting review
  // provisioning — sub-account being created
  // active — fully provisioned and active
  // inactive — cancelled or deactivated
  // suspended — payment issue or violation
  status       String  @default("pending_onboarding")
  warningCount Int     @default(0)
  role         Role    @default(user)

  // Business / A2P info
  businessName        String?
  ein                 String?
  businessType        String?
  businessAddress     String?
  businessCity        String?
  businessState       String?
  businessZip         String?
  businessPhone       String? // Member's self-entered business phone from onboarding — NOT the A2P number.
  businessEmail       String?
  a2pPhone            String? // KYC-assigned A2P sending number, written by the custom-values webhook; null = not yet provisioned. This is the field the tools /enter gate reads.
  websiteUrl          String?
  targetMarket        String?
  smsComplianceAgreed Boolean @default(false)
  onboardingComplete  Boolean @default(false)

  // Addons
  addons              String[]  @default([])
  a2pAddonPurchasedAt DateTime?

  // OTP verification
  otpCode       String?
  otpExpiry     DateTime?
  otpAttempts   Int       @default(0)
  otpLastSentAt DateTime? // Send cooldown timestamp — set on every successful mint/resend/redeliver, independent of otpExpiry.

  // GHL
  ghlContactId              String?
  ghlLocationId             String?
  ghlUserId                 String?
  ghlLocationApiKey         String?
  ghlLocationToken          String?
  ghlLocationTokenExpiresAt DateTime?
  // Note: ONBOARDING_COMPLETE stage ID must be added to GHL_STAGE_* env vars
  onboardingStage           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stripe identity anchor — alongside the ghl* identity fields above.
  stripeCustomerId String? @unique

  // REItools engine back-relations — schema-only, no columns on User.
  wallet        Wallet?
  subscriptions Subscription[]
  ledgerEntries LedgerEntry[]

  // Admin-portal data layer back-relations — schema-only, no columns on User.
  toolUses    ToolUse[]
  creditHolds CreditHold[]

  // Admin audit trail back-relation — schema-only, no columns on User.
  adminActions AdminAction[] @relation("AdminActions")

  // Member consent/audit trail + saved-cart back-relations — schema-only, no columns on User.
  memberActions MemberAction[] @relation("MemberActions")
  carts         Cart[]         @relation("Carts")

  @@unique([ghlLocationId], map: "User_ghlLocationId_key")
}

// Prospect capture from the marketing chat widget — deliberately separate
// from User (a paying member record). Not to be confused with
// User.smsComplianceAgreed, which is a different, onboarding-specific consent.
model Lead {
  id          String    @id @default(cuid())
  name        String?
  phone       String
  email       String
  smsConsent  Boolean   @default(false)
  consentedAt DateTime?
  source      String    @default("chat_widget")
  createdAt   DateTime  @default(now())
}

enum Role {
  user
  admin
  manager
  team_lead
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  ghlLocationId String
  dedupeKey     String   @unique
  paymentStatus String
  amountCents   Int
  currency      String
  createdAt     DateTime @default(now())
}

model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique
  description     String?
  discountPct     Int
  originalPrice   Int
  discountedPrice Int
  active          Boolean  @default(true)
  usageCount      Int      @default(0)
  usageLimit      Int?
  createdAt       DateTime @default(now())
}

model GhlToken {
  id           String   @id @default(cuid())
  locationId   String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Deal {
  id            String   @id @default(cuid())
  locationId    String
  address       String
  dealType      String   @default("sfr")
  arv           Float
  endBuyerMax   Float
  repairLevel   String
  repairs       Float
  wholesaleFee  Float
  mao           Float
  anchorOffer   Float
  investorPct   Float
  narrative     String
  compsUsed     Int
  dealUrl       String
  beds          Int?
  baths         Int?
  sqft          Int?
  asIsValue     Float?
  asIsLow       Float?
  asIsHigh      Float?
  arvLow        Float?
  arvHigh       Float?
  arvConfidence String?
  exitStrategy  String?
  warnings      String[]
  compsJson     String?
  compsRawJson  String?  @db.Text
  lat           Float?
  lng           Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([locationId, address])
}

model PropertyRecord {
  id String @id @default(cuid())

  // Identity
  address          String
  formattedAddress String @unique
  lat              Float?
  lng              Float?

  // Property details
  propertyType String?
  beds         Int?
  baths        Float?
  sqft         Int?
  lotSizeSqft  Int?
  lotSizeAcres Float?
  yearBuilt    Int?
  zoning       String?
  subdivision  String?

  // Features
  garage       Boolean?
  garageSpaces Int?
  carport      Boolean?
  pool         Boolean?

  // Sale data
  lastSalePrice Int?
  lastSaleDate  DateTime?
  priceSource   String?

  // Tax data
  assessedValue     Int?
  taxDelinquentYear String?

  // Owner data (Melissa only)
  ownerName         String?
  ownerOccupied     Boolean?
  ownerType         String?
  mortgageAmount    Int?
  estimatedValue    Int?
  estimatedValueMin Int?
  estimatedValueMax Int?

  // Source tracking
  source       String
  lastVerified DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lat, lng])
  @@index([source])
  @@index([lastSaleDate])
  @@index([lastSalePrice])
  @@index([beds, baths, sqft])
}

// Vendor spend. One or more rows per ToolUse — one per actual vendor hit
// (Melissa, Rentcast, Anthropic-Haiku, Anthropic-Sonnet). `resource` stays
// the vendor; `model` is the Anthropic sub-model (Haiku vs Sonnet — different
// rates), null for record-vendors. `toolUseId`/`tool`/`featureSlug` tie a
// vendor hit back to the run that caused it; `isAdmin` mirrors ToolUse so
// expense views can exclude admin testing by default.
//
// ApiCall (and ToolUse) are ADMIN-EYES: usage + company cost, drives margin.
// LedgerEntry is CLIENT-EYES: the client's credits/allowance/wallet, and
// never carries company cost. Cost lives here, per-resource, so per-tool /
// per-vendor / per-model cost is derivable — and admin/free runs, which have
// ApiCalls but no ledger row, still capture cost.
model ApiCall {
  id          String   @id @default(cuid())
  locationId  String
  resource    String
  endpoint    String
  statusCode  Int
  resultCount Int?
  durationMs  Int?
  createdAt   DateTime @default(now())

  toolUseId    String?
  toolUse      ToolUse? @relation(fields: [toolUseId], references: [id], onDelete: Restrict)
  tool         String?
  featureSlug  String?
  model        String?
  inputTokens  Int?
  outputTokens Int?
  isAdmin      Boolean  @default(false)
  // Frozen at call time from the VendorRate in effect then. True marginal
  // cost for per-call vendors (Melissa flat, Anthropic tokens×rate); a
  // notional marker for Rentcast — real Rentcast cost is derived read-side
  // from call count + VendorPlan (Option B: subscription amortization).
  costCents    Int?
  // Partial index (WHERE model IS NOT NULL) is hand-written into the
  // migration SQL, not expressed here — same convention as the hand-written
  // partial unique indexes noted on Subscription/BundlePriceOverride above,
  // since Prisma's schema DSL can't declare a partial index predicate. Most
  // rows (Melissa/Rentcast) have model = null; only the Anthropic rows the
  // vendor-expense view actually groups by ("cost per model") need indexing.

  @@index([locationId])
  @@index([resource])
  @@index([createdAt])
  @@index([toolUseId])
  @@index([resource, createdAt])
  @@index([featureSlug, createdAt])
}

// Admin-editable rate book — append-only, effective-dated. Raising a price
// is an INSERT, never an update, so historical ApiCall.costCents stays
// explainable against the rate that was actually in effect. The current
// rate for a call is the row with the latest effectiveFrom <= call time for
// that (resource, model).
model VendorRate {
  id                     String   @id @default(cuid())
  resource               String // rentcast | melissa | anthropic
  model                  String? // sonnet | haiku; null for record vendors
  flatCents              Int? // Melissa per-call, Rentcast notional per-call
  perMillionInputTokens  Int? // Anthropic — integer cents per 1M tokens so
  perMillionOutputTokens Int? // fractional-cent rates don't round to zero
  effectiveFrom          DateTime
  createdAt              DateTime @default(now())

  @@index([resource, model, effectiveFrom])
}

// Subscription vendors ONLY — currently just Rentcast. Melissa has no
// VendorPlan row; that absence is what marks a vendor as pure per-call.
model VendorPlan {
  id                  String   @id @default(cuid())
  resource            String   @unique
  baseMonthlyCents    Int
  includedQuota       Int // calls included per month
  overageCentsPerCall Int
  periodAnchorDay     Int // billing day of month
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model LandDeal {
  id                   String   @id @default(cuid())
  locationId           String
  address              String
  lat                  Float?
  lng                  Float?
  lotSizeSqft          Int?
  lotSizeAcres         Float?
  zoning               String?
  roadAccess           String?
  utilities            String[]
  topography           String?
  estimatedValue       Float
  estimatedValueLow    Float?
  estimatedValueHigh   Float?
  valueConfidence      String?
  valueMethod          String?
  builderActivityLevel String?
  builderActivityNote  String?
  exitStrategy         String?
  narrative            String?
  risks                String[]
  warnings             String[]
  compsJson            String?
  compsRawJson         String?  @db.Text
  discount             Float?
  endBuyerMax          Float?
  wholesaleFee         Float?
  cashOffer            Float?
  anchorOffer          Float?
  dealUrl              String?
  dealType             String   @default("land")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([locationId, address])
}

// --- REItools engine: catalog, entitlement, wallet + ledger ---------------
// Spec: .claude/rei-tools/REItools-Wallet-Engine-Sprint.md. Additive — nothing
// in the running app reads these tables yet (lib/catalog.ts still reads the
// config/catalog.ts const seed). Money is Int cents. Each number is owned by
// one canonical row and read through FKs, never copied down. Every relation is
// onDelete: Restrict so catalog/user deletes can't erase ledger provenance.

enum FeatureBucket {
  core_included
  addon
}

enum MeteringShape {
  per_cycle
  by_volume
  none
}

// Declaration order IS the ordering — replace-not-stack "highest wins" is max(level).
enum TierLevel {
  base
  plus
  pro
}

enum BundleLevel {
  plus
  pro
}

enum SubscriptionStatus {
  active
  past_due
  canceled
}

enum LedgerKind {
  funding
  consumption
}

enum FundingReason {
  pack_purchase
  tier_grant
  bundle_grant
  adjustment
  admin_grant
}

enum ConsumptionOutcome {
  success
  fail
}

// Billing / metering / entitlement unit. Owns everything shared across its
// surfaces (bots = one Feature, two surfaces). No `active` — availability is
// derived from its surfaces.
model Feature {
  id               String        @id @default(cuid())
  slug             String        @unique
  bucket           FeatureBucket
  meteringShape    MeteringShape
  creditCost       Int // credits per debit
  unitsPerDebit    Int           @default(1) // REIask: 1 credit per 5 units
  consumptionEvent String
  unifiedName      String? // shown only when ALL surfaces are active (REIclose)
  unifiedTagline   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tiers          Tier[]
  surfaces       Tool[]
  ledgerEntries  LedgerEntry[]
  subscriptions  Subscription[]
  priceOverrides BundlePriceOverride[]
}

// Render surface / card. Owns per-card identity and THE activation gate.
model Tool {
  id           String   @id @default(cuid())
  slug         String   @unique
  featureId    String
  feature      Feature  @relation(fields: [featureId], references: [id], onDelete: Restrict)
  name         String
  tagline      String
  hook         String
  icon         String
  wordmark     String
  category     String
  unit         String // translator unit ("analyses", "handoffs")
  active       Boolean  @default(false) // per-surface gate — activation is a data change, not a deploy
  launchable   Boolean
  launchTarget String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ledgerEntries LedgerEntry[]
}

// Canonical per (feature, level) — owns price + allowance.
model Tier {
  id            String    @id @default(cuid())
  featureId     String
  feature       Feature   @relation(fields: [featureId], references: [id], onDelete: Restrict)
  level         TierLevel
  displayName   String? // optional override; default derives from name + level suffix
  priceCents    Int // 0 for membership-granted base tiers
  allowance     Int? // included units per period; null = unlimited
  stripePriceId String?   @unique // null for membership-granted base tiers
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bundles       BundleTier[]
  subscriptions Subscription[]
  cartLines     CartLine[]

  @@unique([featureId, level])
}

// No `active` — availability derives from all covered surfaces being active.
// No base bundle: "included in Core" is display-only, never a row.
// Definition-only: which named bundle a set of tool_subs derives into, and
// its display price. Never a Stripe object and never a subscription target
// — see BundlePriceOverride for the per-line in-bundle Stripe Prices.
model Bundle {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String
  level      BundleLevel
  priceCents Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tiers          BundleTier[]
  priceOverrides BundlePriceOverride[]
}

// Which specific tier rows a bundle covers. Insert/delete only.
model BundleTier {
  id        String   @id @default(cuid())
  bundleId  String
  bundle    Bundle   @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  tierId    String
  tier      Tier     @relation(fields: [tierId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([bundleId, tierId])
}

// Sparse in-bundle price override: one row ONLY where in-bundle price !=
// à-la-carte (checkout/webhook/resolver fall back to the tier's own
// stripePriceId when no row matches). Unique on the triple, not on
// (featureId, level) alone — each (feature, level) sits in ≤1 bundle today,
// but bundleSlug is kept so a future collision is an INSERT, not a
// migration. bundleSlug (not bundleId) so this survives independent of
// Bundle row churn and reads directly off the slug the qualification
// function already returns.
model BundlePriceOverride {
  id            String    @id @default(cuid())
  featureId     String
  feature       Feature   @relation(fields: [featureId], references: [id], onDelete: Restrict)
  level         TierLevel
  bundleSlug    String
  bundle        Bundle    @relation(fields: [bundleSlug], references: [slug], onDelete: Restrict)
  stripePriceId String?   @unique // null until Pass 2 mints the real in-bundle Stripe Price; unique so checkout/webhook can reverse-lookup a line's Price the same way Tier.stripePriceId does
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([featureId, level, bundleSlug])
}

// Universal wallet top-up — not per-tool.
model CreditPack {
  id            String   @id @default(cuid())
  slug          String   @unique
  credits       Int
  priceCents    Int
  stripePriceId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fundingEntries LedgerEntry[]
  cartLines      CartLine[]
}

// Always a tool_sub: bundle membership is DERIVED (see lib/bundleQualify.ts),
// never stored here — a bundle member is N of these rows, one per tool, at
// in-bundle prices (BundlePriceOverride). Chat B activates: featureId
// (denormalized, for the partial unique index below) + a hand-written
// partial unique index on (userId, featureId) WHERE status='active' (one
// active tool_sub per user per feature) — added by a follow-up migration
// since it's not schema.prisma-expressible.
//
// stripeSubscriptionId is NOT globally unique: the store cart can add
// multiple tool-subs before checkout, which mints ONE Stripe subscription
// with multiple recurring items — one stripeSubscriptionId spans multiple
// rows here, one per item. The real per-item uniqueness is a hand-written
// partial unique index on (stripeSubscriptionId, tierId) WHERE
// stripeSubscriptionId IS NOT NULL, added alongside the constraint above —
// also not schema.prisma-expressible, so also hand-written in the same
// follow-up migration.
model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  tierId               String
  tier                 Tier               @relation(fields: [tierId], references: [id], onDelete: Restrict)
  featureId            String // denormalized from tier.featureId
  feature              Feature            @relation(fields: [featureId], references: [id], onDelete: Restrict)
  status               SubscriptionStatus
  periodStart          DateTime // current billing period = the allowance window
  periodEnd            DateTime
  stripeSubscriptionId String? // NOT @unique — see model comment; per-item uniqueness is a hand-written partial index
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId])
  @@index([stripeSubscriptionId])
}

// Idempotency marker for the Stripe webhook — one row per processed
// Stripe event id. Insert-first (unique PK violation = already processed);
// inserted inside the same transaction as the event's effect so a mid-handler
// failure rolls the marker back too (never "mark, then maybe process").
model ProcessedStripeEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

// The single shared credit balance — the one materialized number.
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Append-only — never updated. creditDelta is the only balance-affecting field.
// Funding fields are set on kind = funding rows, consumption fields on
// kind = consumption rows.
//
// CLIENT-EYES only: the client's credits/allowance/wallet — never company
// cost. Company cost lives on ApiCall (ADMIN-EYES), per-resource, where it's
// captured even for admin/free runs that have no ledger row at all.
model LedgerEntry {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind        LedgerKind
  creditDelta Int
  createdAt   DateTime   @default(now())

  // funding
  reason       FundingReason?
  creditPackId String?
  creditPack   CreditPack?    @relation(fields: [creditPackId], references: [id], onDelete: Restrict)
  refId        String? // Stripe / Transaction handle for non-pack funding

  // consumption
  toolId           String? // which surface ran the unit
  tool             Tool?               @relation(fields: [toolId], references: [id], onDelete: Restrict)
  featureId        String? // which pool it drew from — group-by key for allowance-used
  feature          Feature?            @relation(fields: [featureId], references: [id], onDelete: Restrict)
  unitCount        Int?
  creditsDebited   Int?
  allowanceCovered Boolean?
  outcome          ConsumptionOutcome?

  // Admin-portal data layer: which run this consumption row settles. Null
  // for funding/promo/credit rows — only consumption ties back to a run.
  toolUseId String?
  toolUse   ToolUse? @relation(fields: [toolUseId], references: [id], onDelete: Restrict)

  @@index([userId, featureId, createdAt])
}

// --- Admin portal data layer ----------------------------------------------
// Spec: .claude/docs/REItools-Architecture.md, 2026-09-16 admin appendix.
// Three-layer split: LedgerEntry = money, ToolUse = behavior, ApiCall =
// vendor spend. A metered run is 1 ToolUse -> N ApiCall -> (if metered) 1
// LedgerEntry, all correlated through toolUseId; ToolUse is the run/anchor,
// no separate runId needed. Write-path (transactional/ordered write of
// ToolUse + its ApiCalls + the LedgerEntry) is the metering engine's job —
// this pass is the data layer only, nothing writes these tables yet.

enum ToolOutcome {
  success
  fail
  partial
}

enum HoldState {
  open
  committed
  released
}

// One row per tool RUN — the analytics record ("who, which tool, how often,
// outcome"). Grain is per-tool (see architecture doc table): REIscore = 1
// analysis, REIask = 1 query, REIbots = 1 conversation, REIscrub = 1 scrub
// run, REIpack = 1 packet. Both locationId and userId are required — userId
// is also the correlation key that joins to LedgerEntry (which keys on
// userId, not locationId). lib/toolsSession.ts's session payload carries
// both, but resolveSessionUserId() currently only surfaces userId and the
// analyzer routes currently only capture locationId (from the request body)
// — closing that gap so both are available at write time is the metering
// chat's job, not this pass's; the columns are deliberately non-null.
model ToolUse {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  locationId String
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Frozen at write time — NOT derived from User.role at read time. Freezing
  // it keeps historical expense math stable if a user's role changes later
  // (e.g. someone promoted to admin shouldn't retroactively make their past
  // member usage disappear from expense totals, nor vice versa).
  isAdmin Boolean @default(false)

  featureSlug String // polymorphic tool identity (REIscore, REIask, ...)
  kind        String // per-tool run subtype (e.g. SFR | Land for REIscore)
  outcome     ToolOutcome

  // Promoted behavioral columns — queried/grouped by admin analytics views,
  // so real columns rather than JSON. Populated per-tool; null where a given
  // tool doesn't produce that signal.
  compSource         String? // fresh | cache (REIscore)
  propertyDataSource String? // fresh | cache (REIscore)
  escalated          Boolean? // Haiku -> Sonnet, bool (REIbots)
  turnCount          Int? // REIbots
  hitTokenMax        Boolean? // REIask
  retrievalHit       Boolean? // RAG found context vs not (REIask)
  recordCount        Int? // list size — the volume driver (REIscrub)
  regenerated        Boolean? // first generate vs re-render (REIpack)

  // Typed per-tool long-tail detail — NOT the queried fields above. Plain
  // Json? matching this codebase's existing loose-JSON-parsed-on-read
  // convention (cf. Deal.compsJson/compsRawJson), keyed by featureSlug via a
  // discriminated-union TS type + runtime guards in lib/toolUseDetail.ts
  // (written by the metering chat, once rows actually get populated).
  detail Json?

  apiCalls      ApiCall[]
  ledgerEntries LedgerEntry[]
  creditHolds   CreditHold[]

  @@index([locationId, createdAt])
  @@index([userId, createdAt])
}

// Pending credit reservation — the bots cost-protection layer. Model only;
// lifecycle (open on start, commit/release on settle) is the metering
// engine's job, not this pass's.
//
// Available balance = Wallet.balance - sum(open holds). The ledger stays
// ACTUAL-only (never a pending row); holds carry PENDING separately. Member
// history display aggregates settled ledger rows + open holds at READ time
// (a later design-chat concern) — never a table merge. Bounded to ~6 open
// holds per subscription, which is why this table stays small.
model CreditHold {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  locationId String

  toolUseId String
  toolUse   ToolUse @relation(fields: [toolUseId], references: [id], onDelete: Restrict)

  reservedCredits Int
  state           HoldState @default(open)

  // Ref to the LedgerEntry this hold converts into on commit (audit trail:
  // reserved 5 -> charged 4). Null while open/released.
  settledLedgerEntryId String?

  @@index([userId, state])
}

enum AdminActionType {
  tool_activate
  tool_deactivate
  credit_grant
  credit_adjust
  // v1.5 write-plan additions (2026-09-18) — appended, never reordered.
  // No bundle_activate/bundle_deactivate: per §1, bundle availability is
  // DERIVED from per-surface Tool.active — an admin acts on tools
  // (tool_activate/tool_deactivate above), never on a bundle directly.
  cart_stage
  subscription_comp
  subscription_cancel
  service_cancel
  // 2026-09-21 — mirrors MemberActionType's directional pair (§6a: admin/
  // member audit twins label tier-change direction the same way). Appended,
  // never reordered.
  subscription_upgrade
  subscription_downgrade
}

// Admin write-action audit trail. ADMIN-EYES (never surfaced to members) and
// APPEND-ONLY (an admin action is a historical fact — same discipline as
// LedgerEntry): the admin data-access layer must expose no update/delete path
// for this model. Built once, shared across all admin write features — first
// consumers are tool activate/deactivate (Tool.active is the highest-blast-
// radius flag in the system) and promo credits — so the audit trail answers
// "who/when/why" from day one instead of being bolted on after an incident.
model AdminAction {
  id String @id @default(cuid())

  // Always a real user — integrity + join to the admin's name.
  adminUserId String
  adminUser   User             @relation("AdminActions", fields: [adminUserId], references: [id], onDelete: Restrict)
  action      AdminActionType

  // Polymorphic target (tool | wallet | subscription | user | ...) — targetId
  // is a plain string, typed by convention, NOT an FK (Prisma can't FK one
  // column to multiple tables). targetType names which table targetId points at.
  targetType String
  targetId   String

  // Small state deltas only (e.g. { active: false }, { balance: 120 }) — NOT
  // full-object dumps, and no client PII beyond the target id. This is the
  // admin-eyes domain and must not pull member data (email, business fields)
  // across the audience line.
  before Json?
  after  Json?
  note   String? // optional admin reason ("launch", "comp for support issue")

  createdAt DateTime @default(now())

  // Staged-by back-relation: carts an admin staged for a member (saved-cart
  // sub-add flow, v1.5 dependency order item 5) — schema-only, no columns here.
  stagedCarts Cart[] @relation("StagedCarts")

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId, createdAt])
}

// --- Member consent/audit + saved-cart (v1.5 write plan, schema-only pass) -
// Spec: .claude/docs/REItools-Architecture-v3.md §0 pipeline + "Open threads
// — Reprice-on-break consent record" + 2026-09-18 changelog (v1.5 WRITE PLAN,
// dependency order item 1). Nothing writes these tables yet.

enum MemberActionType {
  subscription_add
  subscription_upgrade
  subscription_downgrade
  subscription_remove
  bundle_activate
  bundle_break
  credit_pack_purchase
}

// Member-side twin of AdminAction — append-only, immutable (same discipline
// as AdminAction/LedgerEntry, no update/delete path). Records member
// price-consent at any change to their paid arrangement. NOT a ledger row —
// carries no creditDelta, no money movement (§6 audience split); this is
// consent evidence, not funding/consumption.
model MemberAction {
  id String @id @default(cuid())

  userId String
  user   User              @relation("MemberActions", fields: [userId], references: [id], onDelete: Restrict)
  action MemberActionType

  // Polymorphic target (subscription | tool | ...) — targetId is a plain
  // string, typed by convention, NOT an FK, same pattern as AdminAction.
  targetType String
  targetId   String

  // FROZEN evidence of what the member was shown and agreed to at the time —
  // { timestamp, disclosureText, type }. Never re-derived after the fact.
  consent Json

  // Set for checkout-staged changes (member completed a saved Cart); null
  // for in-place changes (e.g. a downgrade the member drives directly).
  cartId String?
  cart   Cart?   @relation(fields: [cartId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([targetType, targetId, createdAt])
}

enum CartMode {
  subscription
  credit_pack
}

enum CartStatus {
  open
  completed
  expired
}

enum CartSource {
  member_self
  admin_staged
}

// Saved-cart / checkout-staging model (2026-09-18 changelog: "ADMIN
// SUBSCRIPTION-ADD = SAVED-CART model" + v1.5 dependency order item 1).
// Single-intent to match mintCheckout's mixed-cart rejection (lib/checkout.ts)
// — a Cart is either all-subscription or all-credit-pack, never mixed. Lines
// carry catalog refs, NEVER prices — same "stores zero numbers" discipline as
// Subscription (§3). No bundleId: bundles are flattened to N priced tool_sub
// lines before checkout, never a cart-layer concept (lib/checkout.ts, §5).
model Cart {
  id     String     @id @default(cuid())
  userId String
  user   User       @relation("Carts", fields: [userId], references: [id], onDelete: Cascade)
  mode   CartMode
  status CartStatus @default(open)
  source CartSource

  // Staged-by join — set when an admin stages this cart for a member
  // (saved-cart sub-add flow); null for member-self carts.
  adminActionId String?
  adminAction   AdminAction? @relation("StagedCarts", fields: [adminActionId], references: [id], onDelete: SetNull)

  stripeCheckoutSessionId String?
  expiresAt               DateTime?
  createdAt               DateTime @default(now())

  lines         CartLine[]
  memberActions MemberAction[]

  @@index([userId, status])
  // Partial-unique (userId, mode) WHERE status='open' — one open cart per
  // (user, mode) — is a hand-edit in the migration SQL (Phase 2), same
  // convention as the Subscription/BundlePriceOverride partial indexes;
  // Prisma's schema DSL can't express the WHERE predicate.
}

// Cart line — catalog refs only, never a price. Exactly one of tierId /
// creditPackId is set, matching the cart's mode (enforced app-side, not by
// the DB — same convention as Subscription's tier-vs-feature denormalization).
model CartLine {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  tierId String?
  tier   Tier?   @relation(fields: [tierId], references: [id])

  creditPackId String?
  creditPack   CreditPack? @relation(fields: [creditPackId], references: [id])

  createdAt DateTime @default(now())

  @@index([cartId])
}
