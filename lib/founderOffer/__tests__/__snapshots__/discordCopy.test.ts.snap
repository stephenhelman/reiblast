        {
          "name": "How It Works",
          "value": "• We verify you on the claim page
• First claim wins the free slot
• Everyone after gets a $100 invoice
• Your slot locks once it's paid
• Unpaid invoices forfeit after 24 hours",
        },
        {
          "name": "Who Qualifies",
          "value": "Active or trialing members in good standing. Paused or expired accounts don't qualify.",
        },
        {
          "name": "Claims Close",
          "value": "Oct 31 at 11:59 PM CT",
        },
        {
          "name": "​",
          "value": "[Claim your founder slot](https://x.test/founders/claim)",
        },
      ],
      "footer": {
        "text": "REIsite & REIkit provided by OP Web Studio, a subsidiary of Operation Profit LLC",
      },
      "image": {
        "url": "https://img.test/f.png",
      },
      "title": "🚨 Founder Claims Are OPEN",
      "url": "https://x.test/founders/claim",
    },
  ],
  "username": "REIblast",
}
`;

