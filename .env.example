# Database
DATABASE_URL=

# GHL Integration
GHL_AGENCY_ID=         # Your GHL agency company ID
GHL_SNAPSHOT_ID=       # REIblast Core v1 snapshot ID
GHL_AGENCY_API_KEY=    # Agency level PIT key (also used for SaaS/dunning endpoints)
GHL_HQ_API_KEY=        # HQ sub-account PIT key
GHL_HQ_LOCATION_ID=
GHL_COMPANY_ID=
GHL_ONBOARDING_PIPELINE_ID=
GHL_WEBHOOK_SECRET=    # Shared secret for webhook verification
GHL_FROM_EMAIL=        # Verified sending email in GHL e.g. support@mail.reiblast.app
GHL_OTP_WEBHOOK_URL_ONBOARDING=   # Inbound webhook that fires the onboarding OTP SMS automation
GHL_OTP_WEBHOOK_URL_TOOLS=        # Inbound webhook that fires the tools /enter OTP SMS automation

# GHL Pipeline Stage IDs
GHL_STAGE_PAYMENT_RECEIVED=
GHL_STAGE_ONBOARDING_FORM_SENT=
GHL_STAGE_ONBOARDING_FORM_SUBMITTED=
GHL_STAGE_ONBOARDING_CONFIRMED=
GHL_STAGE_SUB_ACCOUNT_PROVISIONED=
GHL_STAGE_CREDENTIALS_SENT=
GHL_STAGE_A2P_SUBMITTED=
GHL_STAGE_ACTIVE=
GHL_STAGE_PAUSED=

# Checkout
NEXT_PUBLIC_CHECKOUT_URL_CORE=        # Core $57/mo, 1 week free trial (currently unreferenced — checkout button now opens NEXT_PUBLIC_CHECKOUT_FORM_URL in a modal)
NEXT_PUBLIC_CHECKOUT_FORM_URL=https://api.leadconnectorhq.com/widget/form/Fdi3w2eMAOuvzRfz3jao   # 7-day trial GHL form, embedded in the checkout page modal
NEXT_PUBLIC_ARI_CHECKOUT_LINK=https://api.leadconnectorhq.com/widget/form/MMCBv8NMGidXLX7MHNSa   # 14-day trial GHL form, embedded on the promo-gated /ari-special page
ARI_CHECKOUT_LINK_30=   # Server-only. 30-day trial GHL form URL for /ari-special (14-day form is NEXT_PUBLIC_ARI_CHECKOUT_LINK above).
ARI_PROMO_CODES=        # Server-only CODE:DAYS list for /ari-special, e.g. ARI14:14,ARI30:30. Days must be 14 or 30. Entered at /ari-special or via ?promo=CODE. Never prefix with NEXT_PUBLIC_.

# Founder's Offer (/founders). All server-only, read per request. Page redirects to /signup unless ENABLED is exactly "true", ENDS_AT is a valid
# future ISO timestamp, and the form link is set. Never prefix with NEXT_PUBLIC_.
FOUNDER_OFFER_ENABLED=false   # Manual kill switch: "true" / "false"
FOUNDER_OFFER_ENDS_AT=2026-11-01T04:59:59Z   # Auto-off deadline (ISO). This value = Oct 31 11:59 PM CT
FOUNDER_CHECKOUT_LINK=   # GHL form URL for the Founder 14 Day Trial form

# Geo gating
NEXT_PUBLIC_REGION_CONTACT_EMAIL=   # Shown on /region-unavailable to non-US visitors blocked from checkout. Defaults to SUPPORT_EMAIL in lib/constants.ts if unset.

# Property Data
RENTCAST_API_KEY=
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# AI
ANTHROPIC_API_KEY=

# App URLs
NEXT_PUBLIC_APP_URL=https://reiblast.app
NEXT_PUBLIC_TOOLS_URL=https://tools.reiblast.app
NEXT_PUBLIC_GHL_APP_URL=https://app.reiblast.app
NEXT_PUBLIC_MENTORSHIP_URL=          # Ari's 1-on-1 mentorship checkout link

# Billing — GHL payment-event webhook (POST /api/webhooks/ghl/payment-event).
# Shared secret the GHL workflow sends in the x-reiblast-billing-secret header. Generate a long random value.
GHL_BILLING_WEBHOOK_SECRET=

# Billing — nightly jobs (POST /api/webhooks/ghl/jobs). See docs/billing-jobs.md.
# Shared secret the GHL scheduled workflow sends in the x-reiblast-jobs-secret header (openssl rand -hex 32).
GHL_JOBS_SECRET=
# Optional: working budget per invocation in ms (default 45000; Hobby functions cap at 60s).
JOBS_TIME_BUDGET_MS=
# Optional: base URL used for self-continuation (default https://$VERCEL_URL).
JOBS_BASE_URL=

# REIblast admin (owner-only; docs/admin.md). Separate from the REItools admin.
# Session signing secret: >= 32 chars and MUST differ from TOOLS_SESSION_SECRET (fails closed otherwise). openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Base32 TOTP secret for the /admin/login fallback. Generate with scripts/admin/setup-owner-auth.ts --apply.
ADMIN_TOTP_SECRET=
# Comma-separated GHL location ids allowed to open /admin/enter (the HQ sub-account location id).
ADMIN_LOCATION_IDS=
# Preview only: "true" also serves /admin/* by path on Vercel preview hosts. Ignored in production.
ADMIN_PATH_ACCESS=
# Neon plan storage limit in MB (project-wide) for the Health page warning banners (70% warn, 90% critical).
NEON_STORAGE_LIMIT_MB=
# Optional: processor fee percentage (e.g. 2.9) used ONLY for a clearly-labeled "estimate" line on /admin/margin. Unset = line hidden.
ADMIN_PROCESSOR_FEE_PCT=

# Billing state engine (docs/dunning-engine.md). "shadow" (default) only records decisions. "live" is built but NOT switched on: it also needs
# DUNNING_LIVE_ACCOUNTS (below) and acts only for the accounts named there. Any other value makes the engine refuse to run.
DUNNING_MODE=shadow

# Billing engine 7b (docs/ghl-workflows.md, docs/cutover.md). None of these are needed while DUNNING_MODE=shadow.
# Shared secret GHL sends in the x-reiblast-events-secret header on the stage-changed and invoice-event webhooks (openssl rand -hex 32).
GHL_EVENTS_SECRET=
# Inbound-webhook workflow URLs the server POSTs intents to (only ever called in live mode, for allowlisted accounts).
GHL_INTENT_URL_ACTIVE_CLIENT=
GHL_INTENT_URL_ONBOARDING=
# Live mode acts ONLY on these GhlAccount ids / locationIds (comma-separated). Empty (default) = nobody, even with DUNNING_MODE=live.
DUNNING_LIVE_ACCOUNTS=
# Onboarding intents outbox (docs/oct1-release.md). "live" sends recorded GhlIntent rows for the onboarding pipeline
# (new_client/onboarding_form_submitted/sub_account_provisioned); anything else (default) records them as skipped_shadow.
# Independent of DUNNING_MODE — never gates onboarding intents off the dunning flag.
ONBOARDING_INTENTS=off
# Pause (ms) between consecutive intent sends in sendPendingIntents; default 1500.
INTENT_SEND_DELAY_MS=1500
# Onboarding → Clients handoff on A2P Approved (live | off). Independent of DUNNING_MODE and DUNNING_LIVE_ACCOUNTS. Run
# scripts/billing/backfill-active-client-since.ts before turning this on.
CLIENT_HANDOFF=off
# Clients ("active_client") pipeline — used by payment-failed (3rd strike → Paused) and active (→ Active Member) routes.
GHL_CLIENTS_PIPELINE_ID=
GHL_CLIENTS_STAGE_PAUSED=
GHL_CLIENTS_STAGE_ACTIVE=
# Onboarding pipeline's "Paused" SIDE stage id (pipeline id is the existing GHL_ONBOARDING_PIPELINE_ID above) —
# used by payment-failed/active when a member has NO Clients-pipeline card yet (never handed off via A2P Approved):
# their onboarding card is moved into this side stage instead of creating a brand-new Clients-pipeline opportunity.
# Separate from GHL_STAGE_PAUSED (legacy single onboarding-pipeline map in lib/constants.ts) so this new path
# doesn't depend on that older plumbing.
GHL_ONBOARDING_STAGE_PAUSED=

# Production database access gate (docs/cutover.md A1). Unset = unchanged existing behavior everywhere. Set ONLY to "prod",
# and ONLY in the Production environment scope, to let getBillingDb()/billing scripts resolve to the production host;
# any other value, or "prod" pointed at a non-production database (or the reverse), throws.
BILLING_DB_TARGET=

# REIblast Discord bot (docs/discord-bot-contract.md). Shared secret the bot sends in the x-reiblast-discord-secret header on
# POST /api/discord/verify/start and /confirm (openssl rand -hex 32). Unset = both endpoints answer reason "server_misconfigured".
DISCORD_BOT_INBOUND_SECRET=

# Server -> Discord bot revoke calls (docs/revoke-contract.md). Base URL of the bot (no trailing path) and the secret sent in the
# x-reiblast-bot-secret header (openssl rand -hex 32; must differ from DISCORD_BOT_INBOUND_SECRET). Either unset = revokes are
# kept in the outbox as config_error and not sent.
DISCORD_BOT_URL=
DISCORD_BOT_OUTBOUND_SECRET=

# /welcome onboarding checklist. All server-only, read per request — never prefix with NEXT_PUBLIC_.
# Permanent REIblast Discord invite. Unset = the Join button is hidden and the page says "Text us for the Discord link".
DISCORD_INVITE_URL=
# Name of the Discord channel holding the bot's Verify button (no #). Unset = "verify".
DISCORD_VERIFY_CHANNEL=
# Optional embed URL for a "how to verify" video. Unset = written steps are shown instead.
VERIFY_VIDEO_URL=

# Founder's Offer Discord promo (app/api/webhooks/ghl-promo). All server-only — never prefix with NEXT_PUBLIC_.
# Secret GHL sends in the x-reiblast-promo-secret header (openssl rand -hex 32). Unset = the route answers "server_misconfigured".
GHL_PROMO_SECRET=
# JSON map of channel key -> Discord webhook URL (https://discord.com/api/webhooks/...). Keys: "promo" (hourly rotation),
# "announcements" (launch post), "ops" (failure alerts, optional). Read at request time; URLs are never logged.
# e.g. {"promo":"https://discord.com/api/webhooks/ID/TOKEN","announcements":"https://discord.com/api/webhooks/ID/TOKEN","ops":"https://discord.com/api/webhooks/ID/TOKEN"}
DISCORD_PROMO_WEBHOOKS=
# LOCAL ONLY — same shape, pointing at your test server. Read only by scripts/promo/preview-discord.ts, never by the route.
#   npx tsx scripts/promo/preview-discord.ts --phase pre|open|launch [--variation 1|2|3|4|all] [--slots 10] [--role-id ID] [--send]
DISCORD_PROMO_WEBHOOKS_TEST=
# Discord role id pinged on the launch post. Unset (or not a numeric id) = the launch post goes out without the mention.
DISCORD_REIBLAST_ROLE_ID=
# Server clock for the promo (ISO 8601 UTC). Pre-launch rotation before OPEN_AT, claims-open rotation until CLOSE_AT, nothing after.
# Missing/invalid = nothing posts. Launch posts only inside [OPEN_AT, CLOSE_AT).
FOUNDER_CLAIMS_OPEN_AT=2026-10-29T00:00:00Z
FOUNDER_CLAIMS_CLOSE_AT=2026-11-01T04:59:59Z
# Optional link overrides. Default to ${NEXT_PUBLIC_APP_URL}/founders and ${NEXT_PUBLIC_APP_URL}/founders/claim.
FOUNDER_SIGNUP_URL=
FOUNDER_CLAIM_URL=

# Founder claim flow (/founders/claim). All server-only — never prefix with NEXT_PUBLIC_.
# Signs the personal claim link minted by POST /api/discord/founder-link (30 min). openssl rand -hex 32. Unset = no link can be minted or opened.
FOUNDERS_LINK_SECRET=
# Signs the /founders session cookie set after the SMS code (30 min, path /founders). openssl rand -hex 32; must differ from the link secret.
FOUNDERS_SESSION_SECRET=
# Inbound-webhook URL of the OP Web Studio workflow that receives the founder claim intent (pipeline "founder"). Unset = intent stays failed/pending.
GHL_INTENT_URL_FOUNDER=
# "live" sends the founder intent; anything else (including unset) records it as skipped_shadow. Independent of DUNNING_MODE.
FOUNDER_INTENTS=
# OP Web Studio -> HQ invoice webhook (POST /api/webhooks/op/invoice), sent in the x-reiblast-op-secret header. openssl rand -hex 32.
# Unset = the route answers "server_misconfigured".
OP_WEBHOOK_SECRET=
